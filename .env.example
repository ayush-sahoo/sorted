# Sorted — environment

# Claude (persona answers). Without this the app runs in "offline" mode and
# serves each mind's stored perspectives instead of generating new ones.
ANTHROPIC_API_KEY=

# Model + effort for persona chat. Lower effort = snappier replies.
SORTED_MODEL=claude-opus-5-5
SORTED_EFFORT=low

# Supabase (optional in v1 — seed data lives in src/data until you connect this)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
